# Copy this file to .env and fill in your own values for local dev - .env is
# gitignored, it never leaves your machine, and springboot4-dotenv loads it
# automatically (docs/arquitectura.md §6.1).
#
# The exact same variable names are what a real production instance needs too
# (EC2, Oracle Compute, whichever - §6.2) - just with real values instead of the
# local defaults below, and set as real OS environment variables there (systemd
# EnvironmentFile, hosting platform config, ...), never as a file copied from here.

# --- Database ---
# Local default already matches backend/docker-compose.yml - no need to touch it
# for dev. In production this has no default (application-prod.yml) and must
# point at wherever MySQL actually runs - colocated via docker-compose.prod.yml,
# or elsewhere.
DB_URL=jdbc:mysql://localhost:3306/centraldungeon?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=centraldungeon
DB_PASSWORD=centraldungeon
# Only read by docker-compose.prod.yml (MySQL's own superuser) - dev's compose
# file hardcodes its own, and the app itself never uses this one either way.
MYSQL_ROOT_PASSWORD=

# --- Discord OAuth2 (decisiones.md #38) ---
# Create an application at https://discord.com/developers/applications, then in its
# OAuth2 tab register the redirect URI: http://localhost:8080/login/oauth2/code/discord
# (swap the host for the real domain in production).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server (guild) id that gates login - right-click the server icon in Discord with
# Developer Mode on, "Copy Server ID". You must be a member of this guild yourself.
DISCORD_GUILD_ID=
# Optional: shown as a "join the server" button when a non-member tries to log in.
DISCORD_INVITE_URL=

# --- App ---
# Origin allowed by CORS and where OAuth2 redirects back to. Local defaults already
# match the frontend dev server. In production, both must be the real domain the
# frontend is served from - never localhost.
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
# false only for local http; must be true wherever the app is served over https
# (already the default in application.yml outside the dev profile).
APP_COOKIE_SECURE=false
# Dev-only default lives in application.yml. Set a real 32+ byte secret outside your
# own machine (#125) - never reuse the insecure default beyond local dev.
APP_JWT_SECRET=
